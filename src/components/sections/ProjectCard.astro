---
interface Props {
  number: string
  category: string
  year: string
  title: string
  description: string
  ctaHref: string
  ctaLabel: string
}

const { number, category, year, title, description, ctaHref, ctaLabel } = Astro.props
---

<article
  class="project-card group relative flex min-h-97.5 flex-col justify-between overflow-hidden rounded-lg border border-border bg-card p-6 transition duration-350 ease-out hover:-translate-y-1.5 hover:border-(--hover-project) max-[760px]:min-h-85"
>
  <div class="project-art absolute inset-0 bottom-[42%] overflow-hidden bg-(--art-bg)" aria-hidden="true"></div>
  <div class="absolute top-5.5 right-5.5 z-1 font-heading text-[10px] font-bold tracking-[0.14em] text-primary">
    {number}
  </div>
  <div class="relative z-1 mt-auto pt-61.25 max-[760px]:pt-51.25">
    <div class="flex justify-between gap-3 text-[11px] tracking-widest text-muted-foreground uppercase">
      <span>{category}</span>
      <span>{year}</span>
    </div>
    <h3 class="mt-3 mb-2.25 font-heading text-[28px] leading-none tracking-tighter text-foreground">{title}</h3>
    <p class="max-w-65 text-[13px] leading-[1.45] text-muted-foreground">{description}</p>
    <a
      href={ctaHref}
      class="mt-5.5 inline-block -translate-x-2 font-heading text-[11px] font-bold tracking-[0.11em] text-primary uppercase no-underline opacity-0 transition duration-300 group-hover:translate-x-0 group-hover:opacity-100 max-[760px]:translate-x-0 max-[760px]:opacity-100"
    >
      {ctaLabel}
    </a>
  </div>
</article>

<style>
  .project-art:before,
  .project-art:after {
    content: "";
    position: absolute;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .project-art:before {
    width: 72%;
    height: 70%;
    right: -12%;
    top: 16%;
    border: 1px solid var(--art-ring);
    border-radius: 50%;
    transform: rotate(-18deg);
  }
  .project-art:after {
    width: 46%;
    height: 46%;
    left: 16%;
    top: 23%;
    background: linear-gradient(135deg, var(--primary), var(--art-gradient-mid) 48%, var(--art-gradient-end));
    clip-path: polygon(0 18%, 78% 0, 100% 75%, 22% 100%);
    opacity: 0.85;
  }
  .project-card:hover .project-art:before {
    transform: rotate(-8deg) scale(1.08);
  }
  .project-card:hover .project-art:after {
    transform: translate(18px, -10px) rotate(8deg);
  }
</style>
