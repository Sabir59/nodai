---
interface Props {
  brandName?: string
  description?: string
  linkOneHref?: string
  linkOneLabel?: string
  linkTwoHref?: string
  linkTwoLabel?: string
  linkThreeHref?: string
  linkThreeLabel?: string
  legal?: string
}

const {
  brandName = "NODAI STUDIO",
  description = "Designing and building digital experiences with ambitious people.",
  linkOneHref = "#benefits",
  linkOneLabel = "Work",
  linkTwoHref = "#how-it-works",
  linkTwoLabel = "Services",
  linkThreeHref = "/support",
  linkThreeLabel = "Process",
  legal = "Case studies reflect real engineering engagements, shared with each client's consent.",
} = Astro.props
---

<footer class="border-t border-border px-[5vw] pt-8.75 pb-11.25">
  <div class="mx-auto grid max-w-310 grid-cols-3 gap-8.75 max-[700px]:grid-cols-1">
    <div>
      <div class="font-heading text-sm font-bold tracking-[0.14em]">{brandName}</div>
      <p class="mt-4 max-w-55 text-[13px] leading-normal text-muted-foreground">{description}</p>
    </div>
    <div class="flex flex-wrap gap-5 text-[13px]">
      <a href={linkOneHref} class="text-muted-foreground no-underline">{linkOneLabel}</a>
      <a href={linkTwoHref} class="text-muted-foreground no-underline">{linkTwoLabel}</a>
      <a href={linkThreeHref} class="text-muted-foreground no-underline">{linkThreeLabel}</a>
    </div>
    <p class="max-w-62.5 justify-self-end text-[11px] leading-normal text-(--legal-dim) max-[700px]:justify-self-start">
      {legal}
    </p>
  </div>
</footer>
