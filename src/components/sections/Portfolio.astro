---
import ProjectCard from "./ProjectCard.astro"
import { caseStudies } from "@/data/projects"

interface Project {
  number: string
  category: string
  year: string
  title: string
  description: string
  ctaHref: string
  ctaLabel: string
}

interface Props {
  eyebrow?: string
  heading?: string
  description?: string
  items?: Project[]
  viewAllHref?: string
  viewAllLabel?: string
}

const {
  eyebrow = "Selected work",
  heading = "A few things<br />we made matter.",
  description = "Real engineering partnerships, not concept work.",
  items = caseStudies.map(({ number, category, year, title, summary, href }) => ({
    number,
    category,
    year,
    title,
    description: summary,
    ctaHref: href,
    ctaLabel: "View case study →",
  })),
  viewAllHref = "/work",
  viewAllLabel = "View all work →",
} = Astro.props
---

<section id="work" class="border-b border-border bg-background px-[5vw] py-28 max-[760px]:py-22.5">
  <div class="mx-auto max-w-310">
    <div class="mb-12 flex items-end justify-between gap-7.5 max-[760px]:flex-col max-[760px]:items-start">
      <div>
        <div class="font-heading text-[11px] font-bold tracking-[0.16em] text-primary uppercase">{eyebrow}</div>
        <h2 class="work-title mt-3.75 text-foreground" set:html={heading} />
      </div>
      <div class="flex flex-col items-end gap-3 max-[760px]:items-start">
        <p class="max-w-72.5 text-sm leading-[1.55] text-muted-foreground">{description}</p>
        <a href={viewAllHref} class="text-sm text-foreground underline-offset-[5px]">{viewAllLabel}</a>
      </div>
    </div>
    <div class="grid grid-cols-2 gap-3.5 max-[760px]:grid-cols-1">
      {items.map((item) => <ProjectCard {...item} />)}
    </div>
  </div>
</section>

<style>
  .work-title {
    font: 500 clamp(34px, 5vw, 64px) / 0.96 var(--font-heading);
    letter-spacing: -0.07em;
  }
</style>
