---
import StepCard from "./StepCard.astro"

interface Step {
  number: string
  title: string
  description: string
}

interface Props {
  eyebrow?: string
  heading?: string
  items?: Step[]
}

const {
  eyebrow = "How we work",
  heading = "From first sketch to final frame.",
  items = [
    {
      number: "01 / 03",
      title: "Discover",
      description: "We find the sharpest opportunity by understanding the business, audience, and ambition.",
    },
    {
      number: "02 / 03",
      title: "Design",
      description: "Strategy becomes a visual and interaction system with a point of view.",
    },
    {
      number: "03 / 03",
      title: "Build + launch",
      description: "We turn the design into fast, scalable technology, then test, tune, and ship it.",
    },
  ],
} = Astro.props
---

<section id="how-it-works" class="bg-card px-[5vw] py-25">
  <div class="mx-auto max-w-310">
    <div class="font-heading text-[11px] font-bold tracking-[0.16em] text-primary uppercase">{eyebrow}</div>
    <h2 class="steps-title mt-3.75 mb-12 text-foreground">{heading}</h2>
  </div>
  <div class="mx-auto grid max-w-310 grid-cols-3 gap-0 border-t border-border max-[760px]:grid-cols-1">
    {items.map((item) => <StepCard {...item} />)}
  </div>
</section>

<style>
  .steps-title {
    font: 500 clamp(34px, 5vw, 64px) / 1 var(--font-heading);
    letter-spacing: -0.07em;
  }
</style>
